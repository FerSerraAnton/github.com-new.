# ── Supabase (Project Settings → API) ─────────────────────────────
# URL del proyecto
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Clave pública (anon / publishable). Es segura en el navegador: RLS protege los datos.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Opcional ──────────────────────────────────────────────────────
# URL pública que aparecerá en el QR (por defecto, la del navegador del profesor)
NEXT_PUBLIC_SITE_URL=

# Los correos autorizados como profesor se guardan en la tabla public.teacher_allowlist:
#   insert into public.teacher_allowlist (email) values ('profesor@uax.es');
