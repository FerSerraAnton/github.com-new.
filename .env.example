# ── Supabase (Project Settings → API) ─────────────────────────────
# URL del proyecto
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Clave pública (anon / publishable). Es segura en el navegador: RLS protege los datos.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave secreta (service_role / secret). SOLO servidor: alta de profesores y enlace de solo lectura.
# No la prefijes nunca con NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ── Profesorado ───────────────────────────────────────────────────
# Correos autorizados a crear cuenta de profesor (separados por comas)
TEACHER_EMAILS=profesor@uax.es

# ── Opcional ──────────────────────────────────────────────────────
# URL pública que aparecerá en el QR (por defecto, la del navegador del profesor)
NEXT_PUBLIC_SITE_URL=
